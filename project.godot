; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="CANUDOS TD"
config/description="Tower Defense tático e histórico ambientado na Guerra de Canudos (1896-1897)."
run/main_scene="res://scenes/map/map.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/sprites/towers/tower_sniper_jagunco.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=704
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
